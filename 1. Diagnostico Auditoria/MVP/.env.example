# Copiar este archivo a .env y completar los valores. El .env NO se versiona.

PROJECT_NAME="Kohem Chemicals MVP API"
SECRET_KEY="CHANGE_THIS_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL="sqlite+aiosqlite:///./kohem.db"
# Orígenes permitidos para CORS (separados por coma). En producción usar el dominio real del frontend.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Motor de lenguaje (DeepSeek). Si la clave queda vacía, el asistente usa reglas.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.3
# asistente: respuestas por plantilla (auditoría). conversacional: el modelo redacta.
AI_MODE=asistente
AI_HISTORY_MAX=8
