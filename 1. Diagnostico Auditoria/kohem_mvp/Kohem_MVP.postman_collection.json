{
  "info": {
    "name": "Kohem Chemicals - MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "material_id",
      "value": "1"
    },
    {
      "key": "order_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Login cliente (JSON)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"cliente\",\n  \"password\": \"ClientPass123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.access_token) pm.collectionVariables.set('token', data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Login OAuth2 (Swagger Authorize)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "cliente"
            },
            {
              "key": "password",
              "value": "ClientPass123!"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "token"
          ]
        }
      }
    },
    {
      "name": "2. Consultar materias primas",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/materials",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "materials"
          ]
        }
      }
    },
    {
      "name": "3. Registrar pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"raw_material_id\": 1,\n      \"quantity\": 2\n    }\n  ],\n  \"notes\": \"Pedido de prueba MVP\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "orders"
          ]
        }
      }
    },
    {
      "name": "4. Consultar pedidos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "orders"
          ]
        }
      }
    },
    {
      "name": "5. Agente IA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Necesito asesoría sobre una formulación\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/ai/chat",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "ai",
            "chat"
          ]
        }
      }
    },
    {
      "name": "6. Logs de auditoría",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/audit-logs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "audit-logs"
          ]
        }
      }
    }
  ]
}